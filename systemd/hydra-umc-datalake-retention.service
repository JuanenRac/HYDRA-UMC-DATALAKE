# Found in an ecosystem-wide software-improvements audit: apply_retention()
# is real and tested but only ever fired via a manual POST /retention/apply
# - no scheduler called it, so a configured retention policy never
# actually applied itself in production. Triggered on a real schedule by
# hydra-umc-datalake-retention.timer (see that file), not run directly.
# Calls the real, already-running hydra-umc-datalake.service's own
# endpoint - it does not touch the sqlite3 file directly, so it never
# runs concurrently with the server's own writes outside what that
# endpoint already serializes.
[Unit]
Description=Apply HYDRA-UMC-DATALAKE's own configured per-series retention policies
After=hydra-umc-datalake.service
Requires=hydra-umc-datalake.service

[Service]
Type=oneshot
User=hydra-umc-datalake
Group=hydra-umc-datalake
ExecStart=/usr/bin/curl --fail --silent --show-error --request POST http://127.0.0.1:8095/retention/apply
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# C13: a real, initial cgroup memory ceiling - a plain curl call never
# legitimately needs more than this; a small, conservative bound rather
# than none at all.
MemoryHigh=64M
MemoryMax=128M
