# =============================================================================
# Daily, a few hours after the retention timer so the two never overlap. A run only touches buckets completely
# older than the policy's rawMs, so running it more often changes nothing; daily is enough.
[Unit]
Description=Daily schedule for the downsampling of HYDRA-UMC-DATALAKE

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
